{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dl-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "playground-dl",
        "run",
        "dev",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100,
      "autoPort": true
    },
    {
      "name": "dl-static",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "playground-dl/scripts/serve-out.cjs",
        "4100"
      ],
      "port": 4100,
      "autoPort": false
    }
  ]
}
